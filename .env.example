PRIVY_APP_ID=
# JWT verification uses public keys; no Privy application secret is required.
# Run the API from the repository root, or replace these with absolute paths.
TAB_PROJECT_ROOT=.
TAB_HOST=127.0.0.1
TAB_PORT=4297
TAB_DATABASE=backend/data/tab-bnb56.sqlite
TAB_BNB_CHAIN_ID=56
TAB_BNB_RPC=https://bsc-dataseed.bnbchain.org
TAB_BNB_LOGS_RPC=https://rpc-bsc.48.club
TAB_BNB_CONFIRMATIONS=3
# Registration-only sponsor. Inject its dedicated key through your secret manager.
# Leave both unset to keep sponsorship unavailable in local development.
TAB_BNB_SPONSOR_ENABLED=false
TAB_BNB_SPONSOR_ADDRESS=
TAB_BNB_SPONSOR_PRIVATE_KEY=
# Enable only after all module code hashes and wiring are verified.
TAB_BNB_PROTOCOL=
TAB_BNB_MANIFEST=contracts/deployments/bnb-56.json
TAB_USDT_ADDRESS=0x55d398326f99059ff775485246999027b3197955
# Leave unset until a verified official TAB token exists.
TAB_OFFICIAL_TOKEN=
TAB_JOB_MERCHANTS=backend/config/job-merchants-bnb.json
TAB_X402_MERCHANTS=backend/config/x402-merchants-bnb.json
OPENROUTER_API_KEY=
TAVILY_API_KEY=
TAB_INFERENCE_DAILY_MICROS=100000

# Reviewed optional finance module manifest; null addresses keep modules unavailable.
TAB_FINANCE_CONFIG=
